// Recorder background process (Node, run with tsx): Node types, no DOM, not part of the Electron build.
// shared/ files are checked through the imports that reach them (shared/bus/bus, shared/topics).
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["recorder.ts"]
}
