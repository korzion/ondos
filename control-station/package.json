{
  "name": "ondos-control-station",
  "productName": "Ondos Control Station",
  "version": "0.1.0",
  "private": true,
  "description": "E Control Station: operator desktop app (Electron, TypeScript)",
  "main": "./out/main/main.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.game-manager.json && tsc --noEmit -p tsconfig.recorder.json",
    "game-manager": "tsx game-manager/main.ts",
    "recorder": "tsx recorder.ts",
    "replay": "cd .. && python -m shared.tools.replay listen --recordings control-station/recordings",
    "fixture-publisher": "cd .. && python control-station/fixtures/fixture_publisher/fixture_publisher.py",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "edu.gtu.cse396.ondos.controlstation",
    "productName": "Ondos Control Station",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development"
    }
  },
  "dependencies": {
    "three": "^0.187.0",
    "uplot": "^1.6.32"
  }
}
