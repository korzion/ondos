// Renderer (the app UI, runs in the browser part of Electron): DOM types, no Node APIs.
// shared/ files are checked through the imports that reach them (@shared/bus/bus, @shared/topics).
// The main process and the build config are checked by tsconfig.node.json.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@shared/*": ["../shared/*"]
    }
  },
  "include": ["src/renderer/**/*.ts"]
}
