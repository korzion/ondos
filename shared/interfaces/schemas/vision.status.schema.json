{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ondos.local/schemas/vision.status.schema.json",
  "title": "vision/status",
  "description": "Payload of vision/status (IF-04). Envelope fields come from envelope.schema.json.",
  "x-interface": "IF-04",
  "type": "object",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "fps_hz": {
      "type": "number",
      "minimum": 0
    },
    "frame_age_ms": {
      "type": "number",
      "minimum": 0
    },
    "is_camera_ok": {
      "type": "boolean"
    },
    "is_calibrated": {
      "type": "boolean"
    },
    "markers_found": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "reprojection_error_mm": {
      "type": "number",
      "minimum": 0
    },
    "maze_match": {
      "type": "string",
      "description": "maze_id of the matching file, or 'none'"
    },
    "cpu_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "cpu_pct",
    "fps_hz",
    "frame_age_ms",
    "is_calibrated",
    "is_camera_ok",
    "markers_found",
    "maze_match",
    "reprojection_error_mm"
  ],
  "unevaluatedProperties": false
}
