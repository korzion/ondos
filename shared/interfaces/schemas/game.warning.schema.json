{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ondos.local/schemas/game.warning.schema.json",
  "title": "game/warning",
  "description": "Payload of game/warning (IF-05). Envelope fields come from envelope.schema.json.",
  "x-interface": "IF-05",
  "type": "object",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "kind": {
      "$ref": "common.schema.json#/$defs/warning_kind"
    },
    "intensity_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "intensity_pct",
    "kind"
  ],
  "unevaluatedProperties": false
}
