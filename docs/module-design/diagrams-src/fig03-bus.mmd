flowchart LR
  subgraph W["Writes"]
    wa["<b>A bridge</b><br/>platform/state, glove/state<br/>platform and glove variables_spec"]:::A
    wc["<b>C Vision</b><br/>vision/ball, vision/maze<br/>vision/edit_state, vision/status<br/>vision/event, vision/image<br/>plan/distance_map, plan/route"]:::C
    wd["<b>D Auto Controller</b><br/>ai/target_tilt, control/target_tilt<br/>ai/status, ai and pid variables_spec"]:::D
    we["<b>E Control Station</b><br/>game/state, game/warning<br/>cs/command, cs/variables/*<br/>game and cs variables_spec"]:::E
  end
  mq(["MQTT broker<br/>one live writer per topic<br/>every program: sys/online/*"]):::X
  subgraph R["Reads"]
    ra["<b>A bridge</b><br/>target tilts, game/state, game/warning<br/>cs/command, cs/variables/platform, glove"]:::A
    rc["<b>C Vision</b><br/>game/state, cs/command<br/>cs/variables/vision"]:::C
    rd["<b>D Auto Controller</b><br/>vision/ball, vision/maze, plan/*<br/>platform/state, platform/variables_spec<br/>game/state, cs/variables/ai, pid"]:::D
    re["<b>E Control Station</b><br/>all topics (Recorder: all<br/>except vision/image)"]:::E
  end
  wa --> mq
  wc --> mq
  wd --> mq
  we --> mq
  mq --> ra
  mq --> rc
  mq --> rd
  mq --> re
